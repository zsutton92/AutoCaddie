<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCaddie.CourseDetailsPage"
             Title="Course Hub"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label x:Name="CourseNameLabel" 
                   Text="Loading Course..." 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#222222" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />

            <!-- Weather Widget -->
            <Border BackgroundColor="White" StrokeThickness="0" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*,*,*" HorizontalOptions="Fill">
                    <!-- Condition -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                        <Label x:Name="WeatherIconLabel" Text="🌤️" FontSize="28" HorizontalOptions="Center" />
                        <Label x:Name="ConditionLabel" Text="--" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Temp -->
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                        <Label Text="Temp" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                        <Label x:Name="TempLabel" Text="--°F" FontSize="22" FontAttributes="Bold" TextColor="#222222" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Wind -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                        <Label Text="Wind" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                        <Label x:Name="WindLabel" Text="-- mph" FontSize="22" FontAttributes="Bold" TextColor="#222222" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <!-- Preview Button -->
                <Button Grid.Column="0" 
                        Text="Preview Map" 
                        BackgroundColor="Transparent" 
                        TextColor="#4A34D4" 
                        BorderColor="#4A34D4" 
                        BorderWidth="2" 
                        CornerRadius="12" 
                        FontAttributes="Bold" 
                        Clicked="OnPreview_Clicked" />

                <!-- Play Button -->
                <Button Grid.Column="1" 
                        Text="Start Round" 
                        BackgroundColor="#4A34D4" 
                        TextColor="White" 
                        CornerRadius="12" 
                        FontAttributes="Bold" 
                        Clicked="OnStartRound_Clicked" />
            </Grid>

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />

            <!-- History Section -->
            <Label Text="Past Rounds Here" FontSize="18" FontAttributes="Bold" TextColor="#222222" />

            <CollectionView x:Name="PastRoundsList" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No recorded rounds here yet. Time to tee it up!" 
                           TextColor="Gray" FontAttributes="Italic" HorizontalOptions="Center" Margin="0,20,0,0"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5" Padding="15" BackgroundColor="White" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding DatePlayed, StringFormat='{0:MMM dd, yyyy}'}" FontSize="14" FontAttributes="Bold" TextColor="#333" />
                                    <Label Text="{Binding TotalScore, StringFormat='Score: {0}'}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Margin="0,0,15,0" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="Putts" FontSize="10" TextColor="Gray" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalPutts}" FontSize="14" FontAttributes="Bold" TextColor="#4A34D4" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="FIR" FontSize="10" TextColor="Gray" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalFIR}" FontSize="14" FontAttributes="Bold" TextColor="#4A34D4" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>