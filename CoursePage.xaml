<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="AutoCaddie.CoursePage"
             Title="Active Round">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="FinishRoundButton" Text="Finish Round" Clicked="OnFinishRound_Clicked" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">

        <!-- MAP: Takes up the upper portion, clean and focused -->
        <maps:Map x:Name="CourseMap" Grid.Row="0" IsShowingUser="True" MapType="Satellite" />

        <!-- TOP RIGHT: Mute / Unmute Button Container -->
        <Border x:Name="MuteButton" Grid.Row="0" HorizontalOptions="End" VerticalOptions="Start" 
                Margin="0,20,20,0" BackgroundColor="#CC000000" StrokeThickness="0"
                WidthRequest="44" HeightRequest="44" Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMuteButton_Clicked" />
            </Border.GestureRecognizers>

            <Grid WidthRequest="44" HeightRequest="44">
                <Path Data="M3,9 v6 h4 l5,5 v-16 l-5,5 z M16.5,12 c0,-1.77 -1.02,-3.29 -2.5,-4.03 v8.05 c1.48,-0.73 2.5,-2.25 2.5,-4.02 z M14,3.23 v2.06 c2.89,0.86 5,3.54 5,6.71 c0,3.17 -2.11,5.85 -5,6.71 v2.06 c4.01,-0.91 7,-4.49 7,-8.77 c0,-4.28 -2.99,-7.86 -7,-8.77 z"
                      Fill="White" Scale="0.8" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                <Path x:Name="MuteSlashPath" Data="M3,3 L21,21" Stroke="White" StrokeThickness="2.5" StrokeLineCap="Round"
                      IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- BOTTOM RIGHT: Clean UI Stack -->
        <VerticalStackLayout Grid.Row="0" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,15,15" Spacing="10">

            <!-- WIND & WEATHER OVERLAY -->
            <Border x:Name="WeatherOverlay" HorizontalOptions="End" Padding="12,6" 
                    BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark=#CC1E1E1E}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2" />
                </Border.Shadow>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label x:Name="WeatherIconLabel" Text="☀️" FontSize="16" VerticalOptions="Center" />
                    <Label x:Name="WindSpeedLabel" Text="-- mph" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}" VerticalOptions="Center"/>
                    <Label x:Name="WindDirectionArrow" Text="↑" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A34D4, Dark=#9B84EC}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Caddie Suggestion Badge -->
            <Grid x:Name="CaddieBadge" HorizontalOptions="End">
                <Border BackgroundColor="#CC4A34D4" Padding="15,8" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label x:Name="SuggestionLabel" Text="Caddie: Calculating..." TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Floating FCB Yardage Badge -->
            <Grid x:Name="YardageBadge" HorizontalOptions="End">
                <Border BackgroundColor="#CC000000" StrokeThickness="0" Padding="15,10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnYardageBadge_Tapped" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="-2">

                        <!-- BIG PLAYS LIKE NUMBER -->
                        <Label x:Name="PlaysLikeLabel" Text="-- YDS" TextColor="#FFD700" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />

                        <!-- SMALL B/C/F STACK -->
                        <Label x:Name="BackYardageLabel" Text="-- B" TextColor="#A0A0A0" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,4,0,0"/>
                        <Label x:Name="YardageLabel" Text="-- C" TextColor="#A0A0A0" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label x:Name="FrontYardageLabel" Text="-- F" TextColor="#A0A0A0" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- Bottom Footer Toolbar -->
        <Frame Grid.Row="1" 
               HasShadow="True" 
               Padding="15" 
               CornerRadius="20" 
               Margin="10" 
               BackgroundColor="White"
               VerticalOptions="End">
            <VerticalStackLayout Spacing="10">

                <!-- Hole Navigation Row -->
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <Button Grid.Column="0" 
                            Text="&lt; Prev" 
                            Clicked="OnPrevHole_Clicked" 
                            BackgroundColor="#4A34D4" 
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8" />

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label x:Name="HoleTitleLabel" 
                               Text="Hole 1" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="Black"
                               HorizontalTextAlignment="Center" 
                               HorizontalOptions="Center" />
                        <Label x:Name="ParLabel" 
                               Text="Par 4" 
                               FontSize="14" 
                               TextColor="#666666" 
                               HorizontalTextAlignment="Center" 
                               HorizontalOptions="Center" />
                        <Label x:Name="RoundToParLabel" 
                               Text="Total: E" 
                               FontSize="12" 
                               TextColor="#4A34D4" 
                               FontAttributes="Bold" 
                               HorizontalTextAlignment="Center" 
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" 
                            Text="Next &gt;" 
                            Clicked="OnNextHole_Clicked" 
                            BackgroundColor="#4A34D4" 
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8" />
                </Grid>

                <!-- Score & Putt Tracker Grid -->
                <Grid x:Name ="ScoringPanel" RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto, Auto, Auto, *" VerticalOptions="Center" RowSpacing="10">

                    <!-- Row 0: Total Strokes -->
                    <Label Grid.Row="0" Grid.Column="1" Text="Strokes:" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" TextColor="Black" Margin="0,0,15,0"/>

                    <Button Grid.Row="0" Grid.Column="2" Text="-" Clicked="OnMinusScore_Clicked" WidthRequest="44" HeightRequest="44" CornerRadius="22" BackgroundColor="#E0E0E0" TextColor="Black" FontSize="22" FontAttributes="Bold" Padding="0"/>
                    <Label x:Name="ScoreLabel" Grid.Row="0" Grid.Column="3" Text="4" VerticalOptions="Center" FontSize="28" FontAttributes="Bold" TextColor="Black" WidthRequest="60" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="4" Text="+" Clicked="OnPlusScore_Clicked" WidthRequest="44" HeightRequest="44" CornerRadius="22" BackgroundColor="#E0E0E0" TextColor="Black" FontSize="22" FontAttributes="Bold" Padding="0"/>

                    <!-- Row 1: Putts -->
                    <Label Grid.Row="1" Grid.Column="1" Text="Putts:" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" TextColor="Black" Margin="0,0,15,0"/>

                    <Button Grid.Row="1" Grid.Column="2" Text="-" Clicked="OnMinusPutt_Clicked" WidthRequest="44" HeightRequest="44" CornerRadius="22" BackgroundColor="#E0E0E0" TextColor="Black" FontSize="22" FontAttributes="Bold" Padding="0"/>
                    <Label x:Name="PuttLabel" Grid.Row="1" Grid.Column="3" Text="0" VerticalOptions="Center" FontSize="28" FontAttributes="Bold" TextColor="Black" WidthRequest="60" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="4" Text="+" Clicked="OnPlusPutt_Clicked" WidthRequest="44" HeightRequest="44" CornerRadius="22" BackgroundColor="#E0E0E0" TextColor="Black" FontSize="22" FontAttributes="Bold" Padding="0"/>

                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Custom Club Selection Overlay -->
        <Grid x:Name="ClubSelectionOverlay" 
              Grid.RowSpan="2"
              BackgroundColor="#CC000000" 
              IsVisible="False">

            <Border BackgroundColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="20,15"
                    StrokeThickness="0"
                    WidthRequest="340"
                    MaximumHeightRequest="550">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label Text="What club did you hit?" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />

                    <Label x:Name="ClubDistanceLabel" 
                           Text="-- Yards" 
                           FontSize="16" 
                           TextColor="Gray" 
                           HorizontalOptions="Center" />

                    <ScrollView VerticalOptions="FillAndExpand" Margin="0,5">
                        <FlexLayout x:Name="ClubFlexLayout"
                                    Wrap="Wrap" 
                                    JustifyContent="Center" 
                                    AlignItems="Center">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Button Text="{Binding Name}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnClubSelected_Clicked"
                                            WidthRequest="54"
                                            HeightRequest="54"
                                            CornerRadius="27"
                                            Margin="4"
                                            BackgroundColor="#F0F0F0"
                                            TextColor="Black"
                                            FontSize="14"
                                            FontAttributes="Bold" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </ScrollView>

                    <!-- Skip Button -->
                    <Button Text="Skip" 
                            Clicked="OnSkipClub_Clicked"
                            BackgroundColor="Transparent" 
                            TextColor="Gray" 
                            HeightRequest="40"
                            Margin="0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>