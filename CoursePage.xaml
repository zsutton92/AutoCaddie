<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="AutoCaddie.CoursePage"
             Title="Active Round">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Finish Round" Clicked="OnFinishRound_Clicked" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">

        <!-- MAP: Takes up the upper portion, clean and focused -->
        <maps:Map x:Name="CourseMap" Grid.Row="0" IsShowingUser="True" MapType="Satellite" />

        <!-- Top Left UI Container -->
        <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Margin="15,20,0,0" Spacing="10">

            <!-- Floating FCB Yardage Badge -->
            <Border BackgroundColor="#CC000000" StrokeThickness="0" Padding="15,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnYardageBadge_Tapped" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="-2">
                    <Label x:Name="BackYardageLabel" Text="-- B" TextColor="#A0A0A0" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="YardageLabel" Text="-- YDS" TextColor="White" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="FrontYardageLabel" Text="-- F" TextColor="#A0A0A0" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Caddie Suggestion Badge -->
            <Border BackgroundColor="#CC4A34D4" Padding="15,8" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label x:Name="SuggestionLabel" Text="Caddie: Calculating..." TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
            </Border>

        </VerticalStackLayout>

        <!-- NEW: Mute / Unmute Auto-Announce Button -->
        <ImageButton x:Name="MuteButton"
                 Source="speaker_on.png"
                 HeightRequest="40"
                 WidthRequest="40"
                 BackgroundColor="#CCF8F2F2"
                 CornerRadius="20"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,20,20,0"
                 Clicked="OnMuteButton_Clicked" />

        <!-- Bottom Footer Toolbar -->
        <Frame Grid.Row="1" 
       HasShadow="True" 
       Padding="15" 
       CornerRadius="20" 
       Margin="10" 
       BackgroundColor="White"
       VerticalOptions="End">
            <VerticalStackLayout Spacing="10">

                <!-- Hole Navigation Row -->
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <Button Grid.Column="0" 
                    Text="&lt; Prev" 
                    Clicked="OnPrevHole_Clicked" 
                    BackgroundColor="#4A34D4" 
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8" />

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label x:Name="HoleTitleLabel" 
                       Text="Hole 1" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="Black"
                       HorizontalTextAlignment="Center" 
                       HorizontalOptions="Center" />
                        <Label x:Name="ParLabel" 
                       Text="Par 4" 
                       FontSize="14" 
                       TextColor="#666666" 
                       HorizontalTextAlignment="Center" 
                       HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" 
                    Text="Next &gt;" 
                    Clicked="OnNextHole_Clicked" 
                    BackgroundColor="#4A34D4" 
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8" />
                </Grid>

                <!-- Score Tracker Row -->
                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5" />

                <Grid ColumnDefinitions="*, Auto, Auto, Auto, *" VerticalOptions="Center">
                    <Label Grid.Column="1" 
                   Text="Strokes:" 
                   VerticalOptions="Center" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="Black"
                   Margin="0,0,15,0"/>

                    <!-- Minus Button -->
                    <Button Grid.Column="2" 
                    Text="-" 
                    Clicked="OnMinusScore_Clicked" 
                    WidthRequest="44" 
                    HeightRequest="44" 
                    CornerRadius="22" 
                    BackgroundColor="#E0E0E0" 
                    TextColor="Black" 
                    FontSize="22" 
                    FontAttributes="Bold"
                    Padding="0"/>

                    <!-- Current Score Display -->
                    <Label x:Name="ScoreLabel" 
                   Grid.Column="3" 
                   Text="4" 
                   VerticalOptions="Center" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="Black"
                   WidthRequest="60" 
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"/>

                    <!-- Plus Button -->
                    <Button Grid.Column="4" 
                    Text="+" 
                    Clicked="OnPlusScore_Clicked" 
                    WidthRequest="44" 
                    HeightRequest="44" 
                    CornerRadius="22" 
                    BackgroundColor="#E0E0E0" 
                    TextColor="Black" 
                    FontSize="22" 
                    FontAttributes="Bold"
                    Padding="0"/>
                </Grid>

            </VerticalStackLayout>
        </Frame>


        <!-- NEW: Custom Club Selection Overlay -->
        <Grid x:Name="ClubSelectionOverlay" 
              Grid.RowSpan="2"
              BackgroundColor="#CC000000" 
              IsVisible="False">

            <Border BackgroundColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="20"
                    StrokeThickness="0"
                    WidthRequest="340">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15">
                    <Label Text="What club did you hit?" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />

                    <Label x:Name="ClubDistanceLabel" 
                           Text="-- Yards" 
                           FontSize="16" 
                           TextColor="Gray" 
                           HorizontalOptions="Center" />

                    <!-- The FlexLayout wraps the buttons into rows automatically -->
                    <FlexLayout x:Name="ClubFlexLayout"
                                Wrap="Wrap" 
                                JustifyContent="Center" 
                                AlignItems="Center">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <!-- Setting Width and Height to 60 with a CornerRadius of 30 makes a perfect circle -->
                                <Button Text="{Binding Name}"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnClubSelected_Clicked"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        CornerRadius="30"
                                        Margin="5"
                                        BackgroundColor="#F0F0F0"
                                        TextColor="Black"
                                        FontSize="16"
                                        FontAttributes="Bold" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </FlexLayout>

                    <!-- Skip Button -->
                    <Button Text="Skip" 
                            Clicked="OnSkipClub_Clicked"
                            BackgroundColor="Transparent" 
                            TextColor="Gray" 
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
