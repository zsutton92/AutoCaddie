<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="AutoCaddie.ScorecardPage"
             Title="Scorecard"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="15">

            <!-- Scorecard Header (High-contrast purple card works great in both themes) -->
            <Border BackgroundColor="{AppThemeBinding Light=#4A34D4, Dark=#3A27B0}" 
                    Padding="20" 
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label x:Name="CourseNameLabel" 
                           Text="Course Name" 
                           TextColor="White" 
                           FontSize="22" 
                           FontAttributes="Bold" />
                    <Label x:Name="DateLabel" 
                           Text="Date" 
                           TextColor="#D1C4E9" 
                           FontSize="14" 
                           Margin="0,0,0,15" />

                    <BoxView HeightRequest="1" Color="#7A68E6" Margin="0,0,0,15" />

                    <Grid ColumnDefinitions="*,*,*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="SCORE" TextColor="#D1C4E9" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="TotalScoreLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="TO PAR" TextColor="#D1C4E9" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="ToParLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="GIR" TextColor="#D1C4E9" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="GirLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3">
                            <Label Text="FIR" TextColor="#D1C4E9" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="FirLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Column Header Legend -->
            <Grid ColumnDefinitions="*, *, *, *" Padding="15,0">
                <Label Grid.Column="0" Text="HOLE" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#888888, Dark=#999999}" HorizontalOptions="Center" />
                <Label Grid.Column="1" Text="PAR" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#888888, Dark=#999999}" HorizontalOptions="Center" />
                <Label Grid.Column="2" Text="SCORE" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#888888, Dark=#999999}" HorizontalOptions="Center" />
                <Label Grid.Column="3" Text="PUTTS" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A34D4, Dark=#9B84EC}" HorizontalOptions="Center" />
            </Grid>

            <!-- Hole-by-Hole Rows -->
            <VerticalStackLayout x:Name="ScoresList" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="15,10" 
                                StrokeThickness="1" 
                                Stroke="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}" 
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*, *, *, *">
                                <!-- Hole Number -->
                                <Label Grid.Column="0" 
                                       Text="{Binding HoleNumber}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>

                                <!-- Par -->
                                <Label Grid.Column="1" 
                                       Text="{Binding Par}" 
                                       FontSize="18" 
                                       TextColor="{AppThemeBinding Light=Gray, Dark=#AAAAAA}" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>

                                <!-- Strokes -->
                                <Label Grid.Column="2" 
                                       Text="{Binding Strokes}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#111111, Dark=White}" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>

                                <!-- Putts -->
                                <Label Grid.Column="3" 
                                       Text="{Binding Putts}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#4A34D4, Dark=#9B84EC}" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Analytics Divider -->
            <BoxView HeightRequest="1" 
                     Color="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}" 
                     Margin="0,10" />

            <!-- Analytics Section Titles -->
            <Label Text="Stroke Trend" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}" 
                   Margin="5,0,0,0" />
            <microcharts:ChartView x:Name="StrokeTrendChart" HeightRequest="200" />

            <Label Text="Putts per Hole" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}" 
                   Margin="5,10,0,0" />
            <microcharts:ChartView x:Name="PuttsChart" HeightRequest="150" Margin="0,0,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>