<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="AutoCaddie.ScorecardPage"
             Title="Round Overview"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="15">

            <!-- Scorecard Header (High-contrast purple card works great in both themes) -->
            <Border BackgroundColor="{AppThemeBinding Light=#4A34D4, Dark=#3A27B0}" 
                    Padding="20" 
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label x:Name="CourseNameLabel" 
                           Text="Course Name" 
                           TextColor="White" 
                           FontSize="22" 
                           FontAttributes="Bold" />
                    <Label x:Name="DateLabel" 
                           Text="Date" 
                           TextColor="#D1C4E9" 
                           FontSize="14" 
                           Margin="0,0,0,15" />

                    <BoxView HeightRequest="1" Color="#7A68E6" Margin="0,0,0,15" />

                    <Grid ColumnDefinitions="*,*,*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="SCORE" TextColor="#D1C4E9" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="TotalScoreLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="TO PAR" TextColor="#D1C4E9" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="ToParLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="GIR" TextColor="#D1C4E9" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="GirLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3">
                            <Label Text="FIR" TextColor="#D1C4E9" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="FirLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Front 9 Table -->
            <Label Text="FRONT 9" FontSize="12" FontAttributes="Bold" TextColor="#7C4DFF" Margin="5,4,0,0" />
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="6" CornerRadius="10" BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" HasShadow="False">
                <Grid x:Name="Front9Grid" RowSpacing="6" ColumnSpacing="2">
                    <!-- Populated programmatically -->
                </Grid>
            </Frame>

            <!-- Back 9 Table -->
            <Label Text="BACK 9" FontSize="12" FontAttributes="Bold" TextColor="#7C4DFF" Margin="5,4,0,0" />
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="6" CornerRadius="10" BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" HasShadow="False">
                <Grid x:Name="Back9Grid" RowSpacing="6" ColumnSpacing="2">
                    <!-- Populated programmatically -->
                </Grid>
            </Frame>

            <!-- Analytics Divider -->
            <BoxView HeightRequest="1" 
                     Color="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A2A}" 
                     Margin="0,15" />

            <!-- Analytics Section Titles -->
            <Label Text="Stroke Trend" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}" 
                   Margin="5,0,0,0" />
            <microcharts:ChartView x:Name="StrokeTrendChart" HeightRequest="200" />

            <Label Text="Putts per Hole" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}" 
                   Margin="5,15,0,0" />
            <microcharts:ChartView x:Name="PuttsChart" HeightRequest="150" Margin="0,0,0,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>