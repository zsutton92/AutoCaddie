<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCaddie.ScorecardPage"
             Title="Scorecard">

    <VerticalStackLayout Padding="10" Spacing="15">

        <!-- Scorecard Header -->
        <Border BackgroundColor="#4A34D4" Padding="20" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <VerticalStackLayout>
                <Label x:Name="CourseNameLabel" Text="Course Name" TextColor="White" FontSize="22" FontAttributes="Bold" />
                <Label x:Name="DateLabel" Text="Date" TextColor="#D1C4E9" FontSize="14" Margin="0,0,0,15" />

                <BoxView HeightRequest="1" Color="#7A68E6" Margin="0,0,0,15" />

                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="TOTAL SCORE" TextColor="#D1C4E9" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="TotalScoreLabel" Text="--" TextColor="White" FontSize="32" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="TO PAR" TextColor="#D1C4E9" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="ToParLabel" Text="--" TextColor="White" FontSize="32" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Column Headers -->
        <Grid ColumnDefinitions="*, *, *" Padding="10,0">
            <Label Grid.Column="0" Text="HOLE" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
            <Label Grid.Column="1" Text="PAR" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
            <Label Grid.Column="2" Text="SCORE" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" />
        </Grid>

        <!-- Hole-by-Hole Grid -->
        <CollectionView x:Name="ScoresList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,2" Padding="15,10" StrokeThickness="1" Stroke="#EEEEEE" BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, *, *">
                            <Label Grid.Column="0" Text="{Binding HoleNumber}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding Par}" FontSize="18" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="{Binding Strokes}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>