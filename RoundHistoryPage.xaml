<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutoCaddie.RoundHistoryPage"
             Title="My Rounds">

    <CollectionView x:Name="HistoryList" SelectionMode="Single" SelectionChanged="OnRoundSelected" Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,5" Padding="15" StrokeThickness="0" BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="{Binding CourseName}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding DatePlayed, StringFormat='{0:MMM dd, yyyy}'}" FontSize="14" TextColor="Gray" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="SCORE" FontSize="10" TextColor="Gray" HorizontalTextAlignment="End" />
                            <Label Text="{Binding TotalScore}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>